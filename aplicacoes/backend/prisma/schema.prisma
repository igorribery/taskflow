generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Papel {
  DONO
  MEMBRO
}

enum AcaoHistorico {
  CRIADA
  STATUS_ALTERADO
  LISTA_ALTERADA
  TITULO_ALTERADO
  DESCRICAO_ALTERADA
  DELETADA
  COMENTARIO_ADICIONADO
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  criadoEm DateTime @default(now())

  workspaces     WorkspaceMembro[]
  tarefasCriadas Tarefa[]
  historicos     HistoricoTarefa[]
  comentarios    ComentarioTarefa[]
}

model Workspace {
  id        String   @id @default(uuid())
  nome      String
  criadoEm DateTime @default(now())

  membros WorkspaceMembro[]
  tarefas Tarefa[]
  listas  ListaKanban[]
}

model ListaKanban {
  id          String   @id @default(uuid())
  workspaceId String
  titulo      String
  ordem       Int      @default(0)
  /// Identificadores fixos das 3 colunas iniciais: todo | doing | done — listas novas ficam null
  slug        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tarefas   Tarefa[]

  @@index([workspaceId, ordem])
}

model WorkspaceMembro {
  id          String   @id @default(uuid())
  workspaceId String
  usuarioId   String
  papel       Papel    @default(MEMBRO)
  entradoEm   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, usuarioId])
}

model Tarefa {
  id           String   @id @default(uuid())
  titulo       String
  descricao    String?
  ordem        Int      @default(0)
  workspaceId  String
  listaId      String
  criadorId    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lista      ListaKanban     @relation(fields: [listaId], references: [id], onDelete: Restrict)
  criador    Usuario         @relation(fields: [criadorId], references: [id])
  historicos HistoricoTarefa[]
  comentarios ComentarioTarefa[]
}

model ComentarioTarefa {
  id        String   @id @default(uuid())
  tarefaId  String
  usuarioId String
  texto     String
  criadoEm  DateTime @default(now())

  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([tarefaId, criadoEm])
}

model HistoricoTarefa {
  id            String        @id @default(uuid())
  tarefaId      String
  usuarioId     String
  acao          AcaoHistorico
  valorAnterior String?
  valorNovo     String?
  criadoEm      DateTime      @default(now())

  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])
}
